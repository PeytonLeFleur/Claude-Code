# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC — this key bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Shared basement operator password gating the /console surface.
CONSOLE_OPERATOR_PASSWORD=change-me

# Secret used to sign the operator session cookie. Use a long random string.
CONSOLE_COOKIE_SECRET=change-me-to-a-long-random-string
